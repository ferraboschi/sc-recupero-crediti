# Database — Supabase PostgreSQL (produzione) o SQLite (sviluppo locale)
# Per Supabase: postgresql://postgres.[project-ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# Per sviluppo locale: sqlite:///data/sc_recupero.db (oppure ometti DATABASE_URL)
DATABASE_URL=sqlite:///data/sc_recupero.db

# FatturaPro API Configuration
FATTURAPRO_API_URL=https://cloud.fatturapro.click
FATTURAPRO_API_KEY=your_fatturapro_api_key_here
FATTURAPRO_DOMAIN=yourdomain.com

# Fattura24 API Configuration (Legacy)
FATTURA24_API_KEY=your_fattura24_api_key_here

# Shopify Configuration
SHOPIFY_STORE_URL=https://yourstore.myshopify.com
SHOPIFY_ACCESS_TOKEN=your_shopify_access_token_here
SHOPIFY_API_VERSION=2026-01
SHOPIFY_PIVA_FIELD=address2

# Auth (obbligatorie: l'app non parte senza)
JWT_SECRET=change_me_long_random_string
AUTH_PASSWORD=change_me

# P.IVA della propria azienda: blacklist per lo scraping FatturaPro (la
# P.IVA del venditore compare su ogni fattura e non e' mai del destinatario).
# Senza questa env il pattern full-text dell'enrichment resta disabilitato.
COMPANY_PIVA=

# Application Configuration
TIMEZONE=Europe/Rome
SCHEDULER_HOUR=8
SCHEDULER_MINUTE=30

# CORS - Frontend origins (comma-separated)
CORS_ORIGINS=https://recupero.sakecompany.com,http://localhost:5173
